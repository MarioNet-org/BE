NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Docker Compose host binding; the server listens on 0.0.0.0:4000 inside its container.
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=4000
DATABASE_URL=mysql://marionet:local-marionet-only@127.0.0.1:3307/marionet
TEST_DATABASE_URL=mysql://marionet:local-marionet-only@127.0.0.1:3307/marionet_test
CLIENT_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://127.0.0.1:4000
# Development writes mail to .local/mail (contains one-time links). Production requires smtp.
MAIL_MODE=file
MAIL_FROM=MarioNet <noreply@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Set only when running behind exactly this many trusted reverse proxies.
TRUST_PROXY_HOPS=0

# Resend: set MAIL_MODE=resend, MAIL_FROM=MarioNet <onboarding@resend.dev>
# Without a verified domain, set this to your Resend account email.
RESEND_API_KEY=
RESEND_TEST_EMAIL=

